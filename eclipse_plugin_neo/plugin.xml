<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="com.sina.weibo.agent.eclipse.neo.PluginStartup">
      </startup>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            id="com.sina.weibo.agent.eclipse.neo.ui.RunVSAgentView"
            name="RunVSAgent"
            class="com.sina.weibo.agent.eclipse.neo.ui.RunVSAgentView">
      </view>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            id="com.sina.weibo.agent.eclipse.neo.commands.switchExtension"
            name="Switch Extension Provider">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="com.sina.weibo.agent.eclipse.neo.ui.actions.ExtensionSwitcherAction"
            commandId="com.sina.weibo.agent.eclipse.neo.commands.switchExtension">
      </handler>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="com.sina.weibo.agent.eclipse.neo.menus.main"
               label="RunVSAgent">
            <command
                  commandId="com.sina.weibo.agent.eclipse.neo.commands.switchExtension"
                  label="Switch Extension Provider"
                  style="push">
            </command>
         </menu>
      </menuContribution>
   </extension>
</plugin>
