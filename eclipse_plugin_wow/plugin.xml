<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.startup">
      <startup
            class="com.sina.weibo.agent.eclipse.wow.plugin.Startup">
      </startup>
   </extension>

   <extension
         point="org.eclipse.ui.views">
      <view
            id="com.sina.weibo.agent.eclipse.wow.ui.RunVSAgentViewPart"
            name="RunVSAgent-wow"
            class="com.sina.weibo.agent.eclipse.wow.ui.RunVSAgentViewPart"
            icon="icons/wecoder-window.svg">
      </view>
   </extension>

   <extension
         point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension
            targetID="org.eclipse.ui.resourcePerspective">
         <view
               id="com.sina.weibo.agent.eclipse.wow.ui.RunVSAgentViewPart"
               relative="org.eclipse.ui.views.TaskList"
               relationship="right"
               ratio="0.5">
         </view>
      </perspectiveExtension>
   </extension>

   <extension
         point="org.eclipse.ui.commands">
      <command
            id="com.sina.weibo.agent.eclipse.wow.commands.extensionSwitcher"
            name="Switch Extension Provider">
      </command>
   </extension>

   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="com.sina.weibo.agent.eclipse.wow.actions.ExtensionSwitcherAction"
            commandId="com.sina.weibo.agent.eclipse.wow.commands.extensionSwitcher">
      </handler>
   </extension>

   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="com.sina.weibo.agent.eclipse.wow.menus.main"
               label="RunVSAgent-wow">
            <command
                  commandId="com.sina.weibo.agent.eclipse.wow.commands.extensionSwitcher"
                  id="com.sina.weibo.agent.eclipse.wow.menus.extensionSwitcher"
                  label="Switch Extension Provider">
            </command>
         </menu>
      </menuContribution>
      <menuContribution
            locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar
               id="com.sina.weibo.agent.eclipse.wow.toolbars.main">
            <command
                  commandId="com.sina.weibo.agent.eclipse.wow.commands.extensionSwitcher"
                  id="com.sina.weibo.agent.eclipse.wow.toolbars.extensionSwitcher"
                  label="Switch Extension Provider">
            </command>
         </toolbar>
      </menuContribution>
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="com.sina.weibo.agent.eclipse.wow.commands.extensionSwitcher"
               id="com.sina.weibo.agent.eclipse.wow.popups.extensionSwitcher"
               label="Switch Extension Provider">
         </command>
      </menuContribution>
   </extension>

</plugin>
